# Non-secret Quirt supervisor and Gateway contract. The authority key is a separate 0440 root:horsey file.
QUIRT_SOCKET_PATH=/run/horsey/quirt.sock
QUIRT_SOCKET_GROUP=horsey
QUIRT_ENABLED=true
QUIRT_SOCKET_MODE=0o660
QUIRT_STATE_ROOT=/var/lib/stealtheye-quirt
QUIRT_DATABASE_PATH=/var/lib/stealtheye-quirt/state.sqlite
QUIRT_TMUX_PATH=/usr/bin/tmux
QUIRT_SHELL=/bin/bash
QUIRT_PYTHON_PATH=/usr/bin/python3
QUIRT_AUTHORITY_SECRET_PATH=/etc/stealtheye-quirt/authority.key
QUIRT_GATEWAY_ID=stealtheye-horsey-gateway
QUIRT_SUPERVISOR_ID=stealtheye-quirt-supervisor
QUIRT_TARGET_HOST=SET_EXACT_VPS_HOST_ID
QUIRT_EXPECTED_ISSUER=https://shell.stealtheye.io
QUIRT_EXPECTED_SUBJECT=stealtheye-owner
QUIRT_EXPECTED_PRINCIPAL_FINGERPRINT=SET_EXACT_64_HEX_FINGERPRINT
QUIRT_GATEWAY_UID=SET_EXACT_FIX_MCP_UID
QUIRT_MAX_FRAME_BYTES=8388608
QUIRT_MAX_BUFFERED_BYTES=16777216
QUIRT_MAX_WRITE_QUEUE_BYTES=8388608
QUIRT_OUTPUT_CHUNK_BYTES=65536
QUIRT_OUTPUT_RETENTION_BYTES=268435456
QUIRT_CONNECTION_TIMEOUT_MS=5000
QUIRT_REQUEST_TIMEOUT_MS=30000
QUIRT_LIVENESS_INTERVAL_MS=15000
QUIRT_REQUEST_MAX_AGE_MS=30000
QUIRT_REPLAY_RETENTION_MS=86400000
QUIRT_LOG_LEVEL=info
QUIRT_COMMIT_SHA=SET_EXACT_40_HEX_COMMIT
