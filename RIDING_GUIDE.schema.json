{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stealtheye.io/schemas/riding-guide-entry-v1.json",
  "title": "RIDING_GUIDE entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entryId",
    "timestamp",
    "horseyRevision",
    "operatorBaseRevision",
    "operatorBaseTree",
    "quirtRevision",
    "userWording",
    "intendedAction",
    "toolOperation",
    "exactCommand",
    "result",
    "chatgptInvoked",
    "horseyReceived",
    "quirtReceived",
    "linuxExecuted",
    "exitStatus",
    "workingWording",
    "blockedWording",
    "observedLimitation",
    "outputReference",
    "verification",
    "supersedes",
    "notes"
  ],
  "properties": {
    "entryId": {"type": "string", "pattern": "^RG-[0-9]{4,}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "horseyRevision": {"type": ["string", "null"]},
    "operatorBaseRevision": {"type": ["string", "null"]},
    "operatorBaseTree": {"type": ["string", "null"]},
    "quirtRevision": {"type": ["string", "null"]},
    "userWording": {"type": "string"},
    "intendedAction": {"type": "string"},
    "toolOperation": {"type": "string"},
    "exactCommand": {"type": ["string", "null"]},
    "result": {
      "type": "string",
      "enum": [
        "WORKS",
        "BLOCKED_BY_PLATFORM",
        "REJECTED_BY_HORSEY",
        "REJECTED_BY_QUIRT",
        "EXECUTED_FAILED",
        "EXECUTED_PARTIAL",
        "EXECUTED_SUCCESS",
        "UNKNOWN",
        "NOT_TESTED"
      ]
    },
    "chatgptInvoked": {"type": ["boolean", "null"]},
    "horseyReceived": {"type": ["boolean", "null"]},
    "quirtReceived": {"type": ["boolean", "null"]},
    "linuxExecuted": {"type": ["boolean", "null"]},
    "exitStatus": {"type": ["integer", "string", "null"]},
    "workingWording": {"type": ["string", "null"]},
    "blockedWording": {"type": ["string", "null"]},
    "observedLimitation": {"type": ["string", "null"]},
    "outputReference": {"type": ["string", "null"]},
    "verification": {"type": "string"},
    "supersedes": {"type": "array", "items": {"type": "string", "pattern": "^RG-[0-9]{4,}$"}},
    "notes": {"type": ["string", "null"]}
  }
}
